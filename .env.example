# API Base URL (opcional - padrÃ£o usa proxy do Vite)
# Se definido, serÃ¡ usado para testes diretos com backend real (FASE 3 - debugAuth)
# Exemplo: VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_API_BASE_URL=

# Desabilitar autenticaÃ§Ã£o (FASE 4 - Modo de desbloqueio)
# Se definido como 'true', o sistema nÃ£o requer login e assume autenticaÃ§Ã£o automÃ¡tica
# Ãštil para desenvolvimento quando o backend/auth nÃ£o estÃ¡ funcional
# Exemplo: VITE_DISABLE_AUTH=true
VITE_DISABLE_AUTH=

# Gemini API Key (para funcionalidades que usam Gemini)
GEMINI_API_KEY=

# Assistente IA — parser local por regras (sem dependência externa obrigatória)
